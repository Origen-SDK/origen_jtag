((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
                                                                 > nvmbist                      1 0 X 0 ;
((tdo):DigCap = Store),stv                                       > nvmbist                      1 0 V 0 ;
// appending 5 MSB bits
repeat 2                                                         > nvmbist                      0 1 X 0 ;
repeat 2                                                         > nvmbist                      1 1 X 0 ;
repeat 2                                                         > nvmbist                      0 1 X 0 ;
repeat 2                                                         > nvmbist                      1 1 X 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
repeat 2                                                         > nvmbist                      1 0 X 0 ;
repeat 2                                                         > nvmbist                      0 0 X 0 ;
repeat 2                                                         > nvmbist                      1 0 X 0 ;
// [JTAG] Transition to Run-Test/Idle...
repeat 2                                                         > nvmbist                      0 1 X 1 ;
repeat 2                                                         > nvmbist                      1 1 X 1 ;
// [JTAG] /Read DR: 0xSSSS
repeat 2                                                         > nvmbist                      0 1 X 1 ;
repeat 2                                                         > nvmbist                      1 1 X 1 ;
repeat 2                                                         > nvmbist                      0 1 X 0 ;
repeat 2                                                         > nvmbist                      1 1 X 0 ;
// ######################################################################
// ## Pattern complete
// ######################################################################
                                                                 > nvmbist                      1 1 X 0 ;
}                                                                                               
